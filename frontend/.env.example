# Firebase web app config — copy this file to `.env` and fill in the values

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# Optional: base URL for your future Cloud Functions / API. Leave blank until
# you have a backend. apiFetch() uses it to prefix request paths.
VITE_API_BASE_URL=

# NOTE: the Pollinations API key is NOT a frontend var anymore. It lives as a
# Firebase Functions secret (server-side) so it never ships to the browser:
#   firebase functions:secrets:set POLLINATIONS_API_KEY
# The AI memory image is generated by the `generateMemoryImage` Cloud Function.
