# Firebase web app config — copy this file to `.env` and fill in the values
# from Firebase console → Project settings → Your apps → SDK setup & config.
# These are public client keys (safe to ship to the browser); they are NOT
# secrets. The `.env` file is gitignored so each developer keeps their own.
#
# Vite only exposes vars prefixed with VITE_ to the client (import.meta.env).

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: base URL for your future Cloud Functions / API. Leave blank until
# you have a backend. apiFetch() uses it to prefix request paths.
VITE_API_BASE_URL=
